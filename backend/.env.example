# APP
APP_NAME=Enterprise Decision Platform API
APP_VERSION=0.1.0
# ENVIRONMENT is accepted as an alias for APP_ENV
APP_ENV=development
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=true

# Server (Render injects PORT — start.sh prefers PORT over API_PORT)
API_HOST=0.0.0.0
API_PORT=8000
PORT=8000
WEB_CONCURRENCY=1

# CORS (comma-separated). Production: set to your Vercel origin(s).
CORS_ORIGINS=http://localhost:3000

# Database — Neon example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# App auto-rewrites to postgresql+psycopg:// and ensures sslmode for Neon / production.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/enterprise_decision
DATABASE_SSL_REQUIRE=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false
DATABASE_CONNECT_RETRIES=3
DATABASE_CONNECT_RETRY_DELAY=1.0
DATABASE_REQUIRED_ON_STARTUP=false
DATABASE_HEALTHCHECK_TIMEOUT=3.0

# Analytics views (read-only)
ANALYTICS_SCHEMA=analytics
ANALYTICS_VIEW_OVERRIDES=
ANALYTICS_CACHE_TTL_SECONDS=60
ANALYTICS_MAX_PAGE_SIZE=500

# Auth / JWT (OAuth IdP not connected yet)
# JWT_SECRET is accepted as an alias for JWT_SECRET_KEY
JWT_SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=edp-api
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_REQUIRED=false
AUTH_DEV_TOKEN_ENABLED=true

# Observability
SLOW_REQUEST_MS=1000
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=edp-api
OTEL_CONSOLE_EXPORT=false

# HTTP performance
GZIP_MINIMUM_SIZE=500
HTTP_CACHE_MAX_AGE_SECONDS=30
# CACHE_CONTROL_MAX_AGE is accepted as an alias for HTTP_CACHE_MAX_AGE_SECONDS
CACHE_CONTROL_MAX_AGE=30
