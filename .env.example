# =============================================================================
# Monorepo environment overview (not loaded by a single process)
# Prefer:
#   backend/.env.example  → Render / API
#   frontend/.env.example → Vercel / Next.js
# =============================================================================

# --- Frontend (Vercel) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=Enterprise Decision Platform
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_AUTH_REQUIRED=false
NEXT_PUBLIC_DEV_ROLES=admin

# --- Backend (Render) ---
APP_ENV=development
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/enterprise_decision
DATABASE_SSL_REQUIRE=false
JWT_SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
AUTH_REQUIRED=false
OTEL_ENABLED=false
HTTP_CACHE_MAX_AGE_SECONDS=30
CACHE_CONTROL_MAX_AGE=30
