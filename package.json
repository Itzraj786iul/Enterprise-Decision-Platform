{
  "name": "enterprise-decision-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise Decision Intelligence Platform monorepo",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "lint:frontend": "npm --prefix frontend run lint",
    "build:frontend": "npm --prefix frontend run build",
    "format:frontend": "npm --prefix frontend run format",
    "test:backend": "cd backend && pytest -q",
    "lint:backend": "cd backend && ruff check .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  }
}
