# NEXT_PUBLIC_* vars are exposed to the browser. Never put secrets here.
# See also: .env.example for the full template used in Vercel.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=Enterprise Decision Platform
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_AUTH_REQUIRED=false
NEXT_PUBLIC_DEV_ROLES=admin
