# =============================================================================
# Frontend public environment (safe for the browser — never put secrets here)
# Copy to .env.local for local development.
# On Vercel: Project Settings → Environment Variables
# =============================================================================

# Canonical API base URL (used by the app)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Alias also accepted by appConfig (same value as NEXT_PUBLIC_API_BASE_URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# development | production | preview
NEXT_PUBLIC_ENVIRONMENT=development
# Alias also accepted
NEXT_PUBLIC_APP_ENV=development

NEXT_PUBLIC_APP_NAME=Enterprise Decision Platform

# Feature flags / auth posture (UI only — backend enforces independently)
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_AUTH_REQUIRED=false

# Dev RBAC until IdP is wired (comma-separated roles). Do not use in real prod IdP flows.
NEXT_PUBLIC_DEV_ROLES=admin
